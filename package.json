{
  "name": "ethara-ai-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @ethara-ai/frontend\" \"npm run dev -w @ethara-ai/backend\"",
    "start": "node index.js",
    "build": "npm run build -w @ethara-ai/frontend",
    "install:all": "npm install",
    "frontend": "npm run dev -w @ethara-ai/frontend",
    "backend": "npm run dev -w @ethara-ai/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
